
# PRACTICAL 4: ANOMALY DETECTION USING AUTOENCODER

import tensorflow as tf
import numpy as np
import matplotlib.pyplot as plt

# Load MNIST dataset
(x_train, y_train), (x_test, y_test) = tf.keras.datasets.mnist.load_data()

# Normalize and flatten images
x_train = x_train.reshape(-1, 784).astype("float32") / 255.0
x_test = x_test.reshape(-1, 784).astype("float32") / 255.0

# Use only digits 0-4 for normal training
normal = x_train[y_train < 5]
np.random.shuffle(normal)
train, val = normal[:int(len(normal)*0.9)], normal[int(len(normal)*0.9):]

# Build Autoencoder
model = tf.keras.Sequential([
    tf.keras.layers.Input(shape=(784,)),
    tf.keras.layers.Dense(128, activation="relu"),
    tf.keras.layers.Dense(32, activation="relu"),
    tf.keras.layers.Dense(128, activation="relu"),
    tf.keras.layers.Dense(784, activation="sigmoid")
])

# Compile and train the model
model.compile(optimizer="adam", loss="mse")
history = model.fit(train, train, epochs=10, batch_size=128,
                    validation_data=(val, val))

# Calculate reconstruction error and set threshold
val_output = model.predict(val, verbose=0)
val_error = np.mean((val - val_output)**2, axis=1)
threshold = np.percentile(val_error, 95)
print("Anomaly Threshold:", threshold)

# Test images and calculate reconstruction error
output = model.predict(x_test, verbose=0)
error = np.mean((x_test - output)**2, axis=1)

# Predict normal or anomaly
actual = (y_test >= 5).astype(int)
predicted = (error > threshold).astype(int)

print("Test Accuracy:", np.mean(actual == predicted) * 100, "%")
print("Normal images correctly detected:", np.sum((actual == 0) & (predicted == 0)))
print("Anomalies correctly detected:", np.sum((actual == 1) & (predicted == 1)))

# Plot training and validation loss
plt.plot(history.history["loss"], label="Training Loss")
plt.plot(history.history["val_loss"], label="Validation Loss")
plt.title("Autoencoder Training Loss")
plt.xlabel("Epoch")
plt.ylabel("Loss")
plt.legend()
plt.show()

# Display original and reconstructed images
plt.figure(figsize=(10, 4))
for i in range(5):
    plt.subplot(2, 5, i+1)
    plt.imshow(x_test[i].reshape(28, 28), cmap="gray")
    plt.title("Original")
    plt.axis("off")

    plt.subplot(2, 5, i+6)
    plt.imshow(output[i].reshape(28, 28), cmap="gray")
    plt.title("Reconstructed")
    plt.axis("off")
plt.tight_layout()
plt.show()

# Plot reconstruction error and anomaly threshold
plt.hist(error, bins=50)
plt.axvline(threshold, color="red", linestyle="--", label="Threshold")
plt.title("Anomaly Detection")
plt.xlabel("Reconstruction Error")
plt.ylabel("Number of Images")
plt.legend()
plt.show()

# Display sample predictions
for i in range(10):
    result = "Anomaly" if predicted[i] else "Normal"
    print("Actual Digit:", y_test[i],
          "| Prediction:", result,
          "| Error:", round(error[i], 5))
