
# PRACTICAL 5: CONTINUOUS BAG OF WORDS (CBOW)

import numpy as np
import tensorflow as tf
import matplotlib.pyplot as plt
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Embedding, Lambda, Dense

# Sample training sentences
sentences = [
    "I love deep learning",
    "I love machine learning",
    "Deep learning is interesting",
    "Machine learning is useful",
    "I enjoy learning AI",
    "AI is the future of technology"
]

# Create vocabulary
words = " ".join(sentences).lower().split()
vocab = sorted(set(words))
word_to_id = {word: i for i, word in enumerate(vocab)}
id_to_word = {i: word for word, i in word_to_id.items()}

# Generate context-target pairs
data = []
for sentence in sentences:
    tokens = [word_to_id[w] for w in sentence.lower().split()]
    for i in range(1, len(tokens)-1):
        context = [tokens[i-1], tokens[i+1]]
        target = tokens[i]
        data.append((context, target))

X = np.array([item[0] for item in data])
y = np.array([item[1] for item in data])

# Build CBOW model
model = Sequential([
    Embedding(len(vocab), 10, input_length=2),
    Lambda(lambda x: tf.reduce_mean(x, axis=1)),
    Dense(len(vocab), activation="softmax")
])

# Compile and train model
model.compile(optimizer="adam",
              loss="sparse_categorical_crossentropy",
              metrics=["accuracy"])

history = model.fit(X, y, epochs=200, verbose=0)

# Evaluate model
loss, accuracy = model.evaluate(X, y, verbose=0)
print("Vocabulary:", vocab)
print("Training Accuracy:", accuracy * 100, "%")

# Predict target word from context
context_words = ["i", "deep"]
context = np.array([[word_to_id[w] for w in context_words]])

prediction = model.predict(context, verbose=0)
predicted_word = id_to_word[np.argmax(prediction)]

print("Context Words:", context_words)
print("Predicted Target Word:", predicted_word)

# Display training loss
plt.plot(history.history["loss"])
plt.title("CBOW Training Loss")
plt.xlabel("Epoch")
plt.ylabel("Loss")
plt.show()

# Display learned word embeddings
embeddings = model.layers[0].get_weights()[0]
print("\nWord Embeddings:")
for i, word in id_to_word.items():
    print(word, ":", np.round(embeddings[i], 2))
