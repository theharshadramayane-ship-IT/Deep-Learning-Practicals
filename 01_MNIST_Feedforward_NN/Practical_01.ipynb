# PRACTICAL 1: MNIST FEEDFORWARD NEURAL NETWORK (SHORT VERSION)

# 1. Import libraries
import tensorflow as tf
import numpy as np
import matplotlib.pyplot as plt

# 2. Load MNIST dataset (auto-downloads, no manual upload)
(x_train, y_train), (x_test, y_test) = tf.keras.datasets.mnist.load_data()
print("Train:", x_train.shape, "Test:", x_test.shape)

# 3. Preprocess: normalize to 0-1 and flatten 28x28 -> 784
x_train = x_train.astype("float32").reshape(-1, 784) / 255.0
x_test  = x_test.astype("float32").reshape(-1, 784) / 255.0

# 4. Build Feedforward Neural Network
model = tf.keras.Sequential([
    tf.keras.layers.Input(shape=(784,)),
    tf.keras.layers.Dense(128, activation="relu"),   # hidden layer 1
    tf.keras.layers.Dense(64,  activation="relu"),   # hidden layer 2
    tf.keras.layers.Dense(10,  activation="softmax") # output: digits 0-9
])
model.summary()

# 5. Compile with SGD optimizer
model.compile(optimizer=tf.keras.optimizers.SGD(learning_rate=0.01),
              loss="sparse_categorical_crossentropy",
              metrics=["accuracy"])

# 6. Train the model
history = model.fit(x_train, y_train, epochs=10,
                    batch_size=32, validation_split=0.1, verbose=1)

# 7. Evaluate on test data
loss, acc = model.evaluate(x_test, y_test, verbose=0)
print("Test Loss:", loss)
print("Test Accuracy:", acc * 100, "%")

# 8. Plot training & validation loss / accuracy
plt.figure(figsize=(12, 4))
plt.subplot(1, 2, 1)
plt.plot(history.history["loss"],     label="Train Loss")
plt.plot(history.history["val_loss"], label="Val Loss")
plt.title("Model Loss"); plt.xlabel("Epoch"); plt.ylabel("Loss"); plt.legend()

plt.subplot(1, 2, 2)
plt.plot(history.history["accuracy"],     label="Train Acc")
plt.plot(history.history["val_accuracy"], label="Val Acc")
plt.title("Model Accuracy"); plt.xlabel("Epoch"); plt.ylabel("Accuracy"); plt.legend()
plt.tight_layout(); plt.show()

# 9. Predict 5 test digits and show actual vs predicted
preds = model.predict(x_test[:5], verbose=0)
for i in range(5):
    plt.imshow(x_test[i].reshape(28, 28), cmap="gray")
    plt.title(f"Actual: {y_test[i]} | Predicted: {np.argmax(preds[i])}")
    plt.axis("off"); plt.show()
