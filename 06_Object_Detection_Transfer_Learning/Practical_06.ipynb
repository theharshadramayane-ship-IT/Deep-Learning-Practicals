
# PRACTICAL 6: OBJECT DETECTION USING TRANSFER LEARNING

%pip install -q ultralytics

import matplotlib.pyplot as plt
from ultralytics import YOLO

# Load pre-trained YOLO model
model = YOLO("yolo26n.pt")

# Fine-tune model using COCO8 dataset
# Freeze first 10 layers to retain learned features
model.train(data="coco8.yaml", epochs=3, imgsz=320,
            batch=4, freeze=10, workers=0)

# Validate the trained model
metrics = model.val(data="coco8.yaml")
print("mAP50:", metrics.box.map50)

# Detect objects in a sample image
results = model.predict(
    "https://ultralytics.com/images/bus.jpg",
    conf=0.25
)

# Display image with bounding boxes and labels
image = results[0].plot()
plt.figure(figsize=(10, 6))
plt.imshow(image[:, :, ::-1])
plt.title("Object Detection using YOLO")
plt.axis("off")
plt.show()

# Display detected objects and confidence scores
for box in results[0].boxes:
    class_id = int(box.cls[0])
    confidence = float(box.conf[0])
    print(model.names[class_id],
          "Confidence:", round(confidence * 100, 2), "%")
